# Dependency-Track laid out by release series (v26.11.1).
# Shipping 1.3 on the 1.2 line takes over 1.2's collection and projects,
# renaming them, so their history and audit decisions carry over.
direction: down

before: "Before: 1.2 is live" {
  class: group
  direction: right

  ws: "Workspace" {class: primary}
  c12: "Gateway @ 1.2" {class: primary}
  api12: "Gateway / api @ 1.2" {class: secondary}
  auth12: "Gateway / auth @ 1.2" {class: secondary}
  lb: "Latest builds" {class: accent}

  ws -> c12: {class: flow}
  ws -> lb: {class: flow}
  c12 -> api12: {class: flow}
  c12 -> auth12: {class: flow}
}

after: "After: 1.3 ships on the same line" {
  class: group
  direction: right

  ws: "Workspace" {class: primary}
  c13: "Gateway @ 1.3\nsame project, renamed" {class: highlight}
  api13: "Gateway / api @ 1.3\nBOM unchanged" {class: secondary}
  auth13: "Gateway / auth @ 1.3\nnew BOM, audit history kept" {class: accent}
  lb: "Latest builds" {class: accent}

  ws -> c13: {class: flow}
  ws -> lb: {class: flow}
  c13 -> api13: {class: flow}
  c13 -> auth13: {class: flow}
}

before -> after: "1.3 replaces 1.2" {class: flow-pink}
