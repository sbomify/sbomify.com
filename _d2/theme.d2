# sbomify D2 theme, from the Brand Guidelines v2.0
#
# D2 cannot read CSS variables, so these are copies of the tokens in
# _assets/css/tokens.css. Keep the two in step.
# - Navy 100 (ink):          #25293F
# - Navy 80 (ink-muted):     #51546B
# - Navy 20 (line-strong):   #D3D4D9
# - Navy 10 (line):          #E9EAEC
# - Mist 50 (surface):       #F0F1F5
# - Signal Orange (accent):  #FF6A13
# - Orange 700 (fill behind small white type): #C2410C

# Global Defaults
style: {
  fill: "transparent"
  stroke: "transparent"
  stroke-width: 0
  font-size: 14
  border-radius: 8
}

classes: {
  # Primary - Navy border, white fill
  primary: {
    style: {
      fill: "#FFFFFF"
      stroke: "#25293F"
      font-color: "#25293F"
      stroke-width: 2
      shadow: false
      border-radius: 8
      font-size: 14
    }
  }

  # Accent - Signal Orange border, white fill
  accent: {
    style: {
      fill: "#FFFFFF"
      stroke: "#FF6A13"
      font-color: "#25293F"
      stroke-width: 2
      shadow: false
      border-radius: 8
      font-size: 14
    }
  }

  # Secondary - Navy 20 dashed border (for less emphasis)
  secondary: {
    style: {
      fill: "#FFFFFF"
      stroke: "#D3D4D9"
      font-color: "#51546B"
      stroke-width: 2
      shadow: false
      border-radius: 8
      font-size: 14
      stroke-dash: 3
    }
  }

  # Highlight - Orange fill, white type (for the one key item)
  highlight: {
    style: {
      fill: "#C2410C"
      stroke: "#C2410C"
      font-color: "#FFFFFF"
      stroke-width: 2
      shadow: false
      border-radius: 8
      font-size: 14
      bold: true
    }
  }

  # Group Container
  group: {
    style: {
      fill: "#F0F1F5"
      stroke: "#E9EAEC"
      font-color: "#25293F"
      stroke-width: 1
      border-radius: 12
      font-size: 13
    }
  }

  # Stack style
  stack: {
    style: {
      multiple: true
    }
  }

  # Flow - Navy animated connection
  flow: {
    style: {
      animated: true
      stroke: "#51546B"
      font-color: "#51546B"
      stroke-width: 2
      font-size: 12
    }
  }

  # Flow Pink - Signal Orange animated connection (name kept for existing diagrams)
  flow-pink: {
    style: {
      animated: true
      stroke: "#FF6A13"
      font-color: "#51546B"
      stroke-width: 2
      font-size: 12
    }
  }
}
